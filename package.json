{
  "name": "remix3",
  "private": true,
  "type": "module",
  "scripts": {
    "css:build": "tailwindcss -i app/styles/app.css -o public/tailwind.css --minify",
    "css:watch": "tailwindcss -i app/styles/app.css -o public/tailwind.css --watch=always",
    "dev": "npm run css:build && { npm run css:watch & NODE_ENV=development node --watch --import remix/node-tsx server.ts; }",
    "hmr": "npm run css:build && { npm run css:watch & NODE_ENV=development node hmr.ts; }",
    "start": "npm run css:build && NODE_ENV=production node --import remix/node-tsx server.ts",
    "db:migrate": "remix db migrate",
    "db:status": "remix db status",
    "db:rollback": "remix db rollback",
    "test": "NODE_ENV=test remix test",
    "test:coverage": "NODE_ENV=test remix test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "latest",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "latest"
  }
}
